/**
 * Cloudflare Workers deployment: the built PWA (dist/) is served as static assets, and /relay is a
 * WebSocket sync relay backed by one Durable Object per room (worker/index.ts), so devices can sync
 * through the same origin with no separate server.
 *
 *   npm run deploy        build + wrangler deploy
 *   npm run cf:dev        build + run the Worker locally (http://localhost:8787)
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openstand",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else is served straight from the asset store without invoking the Worker.
    "run_worker_first": ["/relay", "/relay/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayRoom"] }],
  // The official deployment. For your own, change this to a hostname in a zone on your Cloudflare
  // account, or remove it to use https://openstand.<your-subdomain>.workers.dev only.
  "routes": [{ "pattern": "openstand.rodlabs.dev", "custom_domain": true }],
  "vars": {
    // Comma-separated extra origins allowed to use the relay (the site's own origin always is). Empty =
    // any origin; the protocol carries no secrets, but this stops other sites from using your relay.
    "ALLOWED_ORIGINS": "https://openstand.rodlabs.dev"
  },
  // No per-request invocation logs (they'd record IPs and URLs, e.g. relay room names); errors and
  // console output can still be inspected live with `wrangler tail`.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
